<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- отдельный процесс: ядро не делит память с приложением -->
        <service
            android:name="com.leomze.ps1.engine.EngineService"
            android:exported="false"
            android:process=":engine" />
        <!-- ретро-движок (Денди и др.): свой процесс, ядра libretro -->
        <service
            android:name="com.leomze.ps1.engine.RetroEngineService"
            android:exported="false"
            android:process=":retro" />
    </application>
</manifest>
